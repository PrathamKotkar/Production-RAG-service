DATABASE_URL=postgresql://rag:rag@db:5432/rag
REDIS_URL=redis://redis:6379/0

# st = sentence-transformers (real), hash = deterministic offline embedder (tests/CI only)
EMBED_BACKEND=st
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20
CANDIDATE_K=40

CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Optional. Without a key /v1/ask falls back to an extractive answer and
# faithfulness is scored lexically instead of by an LLM judge.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
